#include "mona2.dtsi"
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    aliases {
        led-red = &led_red;
        led-green = &led_green;
        led-blue = &led_blue;
    };

    leds {
        compatible = "gpio-leds";
        led_red: led_red {
            gpios = <&gpio0 26 GPIO_ACTIVE_LOW>;
        };
        led_green: led_green {
            gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
        };
        led_blue: led_blue {
            gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
        };
    };

    // カスタム入力プロセッサー: 閾値付き一時レイヤー
    zip_threshold_temp_layer: input_processor_threshold_temp_layer {
        compatible = "zmk,input-processor-threshold-temp-layer";
        #input-processor-cells = <2>;
        activation-threshold = <100>;  // トラックボールを200ピクセル移動後にレイヤー1に切り替え
        require-prior-idle-ms = <0>;
        excluded-positions = <>;
    };
};

&default_transform {
    col-offset = <6>;
};

&kscan0 {
        // D6(P1.11)をIRQに解放するため、row-gpio[3]をD6→D0(P0.02)に入れ替え
        row-gpios
            = <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D6(P1.11)→D0(P0.02)
            ;
        col-gpios
            = <&xiao_d 10 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH>
            , <&xiao_d 8 GPIO_ACTIVE_HIGH>
            , <&xiao_d 7 GPIO_ACTIVE_HIGH>
            , <&gpio0 10 GPIO_ACTIVE_HIGH>
            ;
};


&pinctrl {
    spi0_default: spi0_default {    //通常時(SPI通信中)のピン構成
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,  //P0.05を指定(SCLK)
                <NRF_PSEL(SPIM_MOSI, 0, 15)>,     //P0.15を指定(heball配線に合わせる)
                <NRF_PSEL(SPIM_MISO, 0, 15)>;
        };
    };

    spi0_sleep: spi0_sleep {    //スリープ時のピン構成(省電力)
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 15)>,
                <NRF_PSEL(SPIM_MISO, 0, 15)>;
            low-power-enable;
        };
    };
};


&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim"; //マイコンがnRFシリーズ
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 19 GPIO_ACTIVE_LOW>;  //P0.19を指定(heball配線に合わせる)

    trackball_central: trackball_central@0 {
        status = "okay";
        compatible = "pixart,paw3222";  //トラボセンサ用のドライバとバインド
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; //P1.11を指定(heball配線に合わせる)

    };
};


// Overrides for the input listener node
&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;

    // 時計回りに90度回転（XY入れ替え + X軸反転）+ オートマウスレイヤー（閾値付き）
    input-processors = <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,
                       <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
                       <&zip_threshold_temp_layer 1 500>;  //オートマウスレイヤー（20ピクセル移動後、レイヤー1に500ms切り替え）

    scroller {
        layers = <6>;
        input-processors = <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,        //X軸とY軸の入れ替え
                           <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,       //X軸反転
                           <&zip_xy_to_scroll_mapper>,                         //スクロールモードに変更
                           <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,   //スクロールのY軸反転
                           <&zip_scroll_scaler 1 5>;                           //スクロール量を1/5倍
    };

};
